PORT=5000
NODE_ENV=development

FRONTEND_URL=http://localhost:3000

# Public URL this API server is reachable at (its own Render URL in
# production) — used to build the QR-code image link embedded in emails.
API_BASE_URL=http://localhost:5000

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=
PAYMONGO_WEBHOOK_SECRET=

# Optional — booking confirmation emails are skipped if unset.
# BREVO_API_KEY: Brevo dashboard > Settings > SMTP & API > API Keys.
# BREVO_SENDER_EMAIL: must be a sender verified in Brevo (Senders, Domains
# & Dedicated IPs > Senders) — verify it via the confirmation email Brevo
# sends before this will work.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=DinkHub
